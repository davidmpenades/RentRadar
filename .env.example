# Plantilla de variables de RentRadar. Cópiala a .env (cp .env.example .env); .env no entra en git.
# Docker Compose interpola "$" en los valores: para un "$" literal escribe "$$" o pon el valor entre comillas simples.

# --- Backend ---
# Entorno de settings: development, test o production.
DJANGO_ENV=development
# Clave secreta de Django. En producción: 50 caracteres o más, aleatoria y sin "insecure-".
DJANGO_SECRET_KEY=insecure-dev-only-not-a-secret
# Modo depuración (true, false, 1 o 0); solo tiene efecto en development.
DJANGO_DEBUG=true
# Hosts permitidos separados por comas (dominio, .dominio o IP); obligatoria en producción.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Host de la base de datos; en Compose, el nombre del servicio.
DB_HOST=db
# Puerto de la base de datos dentro de la red de Compose.
DB_PORT=5432
# Nombre de la base de datos de desarrollo; Compose crea con él la del servicio db.
DB_NAME=rentradar
# Usuario de la base de datos; Compose crea con él el del servicio db.
DB_USER=rentradar
# Contraseña de la base de datos. En producción no puede contener "insecure-".
DB_PASSWORD=insecure-dev-db-password

# --- Ajeno al backend ---
# Clave de Context7 (https://context7.com). Exportarla en el entorno, no aquí.
CONTEXT7_API_KEY=
